{
  "name": "folio-frontend-workspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:candidate": "npm run dev --workspace=candidate-experience-pod",
    "dev:recruiter": "npm run dev --workspace=recruiter-ui",
    "dev:institutional": "npm run dev --workspace=institutional-portal",
    "dev": "npm run dev:candidate & npm run dev:recruiter & npm run dev:institutional",
    "build:candidate": "npm run build --workspace=candidate-experience-pod",
    "build:recruiter": "npm run build --workspace=recruiter-ui",
    "build:institutional": "npm run build --workspace=institutional-portal",
    "build": "npm run build:candidate && npm run build:recruiter && npm run build:institutional"
  }
}
